<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/arcs/db" VERSION="20261105" COMMENT="XMLDB file for Moodle local/arcs"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_arcs_change" COMMENT="Change log read by Arcs: which records changed, by id only. Rows outlive the records they name.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Sequence that readers page by"/>
        <FIELD NAME="entity" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false" COMMENT="Kind of record, such as user or course"/>
        <FIELD NAME="entityid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Id of the record in its Moodle table"/>
        <FIELD NAME="op" TYPE="char" LENGTH="8" NOTNULL="true" SEQUENCE="false" COMMENT="upsert or delete"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User the record belongs to, when it has one"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Course the record belongs to, when it has one"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="When the change was recorded"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
